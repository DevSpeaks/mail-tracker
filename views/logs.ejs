<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Logs — <%= pixel.name %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="container">
      <a href="/" class="back-link">← Back to Dashboard</a>

      <div class="header">
        <h1>📊 <%= pixel.name %></h1>
        <span class="header-badge">Pixel Logs</span>
      </div>

      <%
        const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        function formatDateTime(isoString) {
          const d = new Date(isoString);
          const pad = (num) => num.toString().padStart(2, "0");
          const day = pad(d.getDate());
          const mon = months[d.getMonth()];
          const year = d.getFullYear();
          let hours = d.getHours();
          const minutes = pad(d.getMinutes());
          const seconds = pad(d.getSeconds());
          const ampm = hours >= 12 ? "pm" : "am";
          hours = hours === 0 ? 12 : (hours > 12 ? hours - 12 : hours);
          return `${day} ${mon} ${year} ${pad(hours)}:${minutes}:${seconds}${ampm}`;
        }

        const totalOpens = logs.length;
        const firstOpen = totalOpens > 0 ? formatDateTime(logs[logs.length - 1].time) : '—';
        const lastOpen = totalOpens > 0 ? formatDateTime(logs[0].time) : '—';

        function isBot(userAgent) {
          const botPatterns = /googleimageproxy|ggpht\.com|outlook|microsoft|yahoo.*slurp|bot|crawler|spider|prefetch/i;
          return botPatterns.test(userAgent);
        }

        const groupClasses = ['log-group-a', 'log-group-b', 'log-group-c', 'log-group-d', 'log-group-e', 'log-group-f'];
      %>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value"><%= totalOpens %></div>
          <div class="stat-label">Total Opens</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= uniqueIps %></div>
          <div class="stat-label">Unique IPs</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="font-size:1rem; margin-top:0.45rem"><%= firstOpen %></div>
          <div class="stat-label">First Open</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="font-size:1rem; margin-top:0.45rem"><%= lastOpen %></div>
          <div class="stat-label">Last Open</div>
        </div>
      </div>

      <div class="card" style="padding:0; overflow:hidden;">
        <% if (totalOpens === 0) { %>
          <div class="empty-state">
            <div class="empty-state-icon">👀</div>
            <p>No opens recorded yet. The pixel will log events once the email is opened.</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th style="width:200px">Time</th>
                  <th style="width:140px">IP Address</th>
                  <th>User Agent</th>
                </tr>
              </thead>
              <tbody>
                <%
                  const sortedLogs = logs.slice().reverse();
                  let colorIndex = 0;
                  let lastTime = null;

                  sortedLogs.forEach((log) => {
                    const currentTime = new Date(log.time).getTime();
                    if (lastTime !== null && (currentTime - lastTime) > 2000) {
                      colorIndex = (colorIndex + 1) % groupClasses.length;
                    }
                    lastTime = currentTime;

                    const formatted = formatDateTime(log.time);
                    const isBotRequest = isBot(log.userAgent);
                %>
                  <tr class="<%= groupClasses[colorIndex] %>">
                    <td class="mono"><%= formatted %></td>
                    <td class="mono"><%= log.ip %></td>
                    <td>
                      <%= log.userAgent %>
                      <% if (isBotRequest) { %><span class="bot-tag">BOT</span><% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="card" style="margin-top: 1rem;">
        <div class="card-title">Pixel Details</div>
        <div class="pixel-meta" style="flex-direction:column; gap:0.3rem;">
          <span><strong style="color:var(--text-primary)">ID:</strong> <code style="color:var(--text-muted); font-size:0.8rem"><%= pixel.id %></code></span>
          <span><strong style="color:var(--text-primary)">Created:</strong> <%= formatDateTime(pixel.createdAt) %></span>
        </div>
      </div>
    </div>
  </body>
</html>
